# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BRAPI_TOKEN: Optional token for brapi.dev (fallback data and public endpoint supported)
BRAPI_TOKEN=""

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: captação de e-mails no servidor (newsletter, lista de espera, contato).
# Use SOMENTE no servidor/Secrets, nunca no navegador nem no GitHub.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Conexão cliente e listener de tempo real (Realtime WebSocket)
# para atualização automática de ativos e metas na página da Carteira.
# Copie do painel Project Settings > API > Project URL e Anon/Public Key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Em produção use "npm run build" e depois "npm start" (já ativa o modo produção).
# DEMO_MODE=true mostra dados de demonstração (apenas desenvolvimento).

# GEMINI_MODEL: nome do modelo da IA (opcional). Se não existir, o servidor tenta "gemini-flash-latest".
GEMINI_MODEL="gemini-flash-latest"
